# Install: edit User / WorkingDirectory / ExecStart to match this machine, then
#   sudo cp systemd/hearth.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now hearth
[Unit]
Description=Hearth: phone remote, library and radio for the TV box (:5080)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/opt/hearth-tv
# The venv made in docs/setup.md. systemd's PATH is short, so yt-dlp and deno are
# looked for next to this python as well as on PATH.
ExecStart=/opt/hearth-tv/.venv/bin/python -m hearth.server
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
