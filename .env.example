# Copy to .env (same folder) and fill in. .env is gitignored. See docs/server.md for every key.

# The phone remote's login password, and the keys that sign its cookie + the Pi's media URLs.
TV_PASSWORD=
TV_SECRET_KEY=            # python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TV_RECEIVER_TOKEN=        # the same value goes in the Pi's ~/hearth/config.json "token"

# Where the Pi's receiver listens.
TV_RECEIVER_URL=http://hearth-tv.local:8770
TV_PORT=5080
# 1 when the remote is reached over HTTPS (a Cloudflare tunnel, tailscale serve); 0 on a plain-http LAN.
TV_COOKIE_SECURE=0

# The media share: Movies/, Shows/<Show>/, Music/. TV_MEDIA_ROOT is this machine's path to it
# (uploads, disc rips and the share watcher write there), TV_JELLYFIN_MEDIA_ROOT the same folder
# as the Jellyfin container sees it (only flamingo/prepare_audio.py needs that one).
TV_MEDIA_ROOT=/mnt/media
TV_JELLYFIN_MEDIA_ROOT=/media

# Jellyfin: an API key (Dashboard > API Keys) and the household's own Jellyfin user.
JELLYFIN_URL=http://127.0.0.1:8096
# How the Pi reaches Jellyfin: mpv opens stream URLs built from this, so it must be this server's
# LAN address as the Pi sees it, never 127.0.0.1. Defaults to JELLYFIN_URL.
JELLYFIN_PI_URL=http://hearth-server.local:8096
JELLYFIN_API_KEY=
JELLYFIN_USER=
JELLYFIN_PASSWORD=

# Optional: an old iTunes "iTunes Music Library.xml" gives the radio years of play counts and playlists.
# TV_ITUNES_XML=/mnt/media/Music/iTunes/iTunes Music Library.xml

# Optional: the USB CD/DVD drive (docs/server.md § Discs).
TV_DISCS=0
# TV_DISC_DEVICE=/dev/sr0
# TV_DISC_SCRATCH=/var/tmp/hearth-disc-rips
# Contact for MusicBrainz's User-Agent and the Web Push VAPID claim (an email or URL you own).
# TV_CONTACT=

# Music Flamingo's descriptions (docs/radio.md): a local file, or the GPU box over ssh.
# FLAMINGO_DESCRIPTIONS=/opt/hearth-tv/flamingo/out/describe.jsonl
# FLAMINGO_SSH=user@gpu-box:~/flamingo/out/describe.jsonl
